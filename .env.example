# Postgres connection
DATABASE_URL=postgres://somax:somax@localhost:5432/somax

# Long random string for admin endpoints. Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string

PORT=2999

# Served content. Collections live at:
#   $CONTENT_ROOT/curriculum/rwanda   -> /metadata, /content/<path>
#   $CONTENT_ROOT/books               -> /library-metadata, /content/library/<id>.epub
CONTENT_ROOT=./content

# Upload temp files (must not be inside CONTENT_ROOT; same disk is best)
DATA_DIR=./data

# Comma-separated origins, or * for any
CORS_ORIGINS=*

# Auto-index files copied into CONTENT_ROOT (SFTP/scp)
WATCH_CONTENT=true

# ffprobe binary for audio/video durations (apt install ffmpeg)
FFPROBE_PATH=ffprobe

MAX_UPLOAD_MB=2048
